# -*- mode: makefile -*-
ROOT = ..
OBJDIR = ${ROOT}/objs
BINDIR = ${ROOT}/bin

intron_prospector = ${BINDIR}/intron-prospector
intron_prospector_merge = ${BINDIR}/intron-prospector-merge

shared_SRCS = junctions.cc junctions_extractor.cc genome.cc zfstream.cc splice_juncs.cc
intron_prospector_SRCS =  intron-prospector.cc
intron_prospector_merge_SRCS = intron-prospector-merge.cc
SRCS = ${shared_SRCS} ${intron_prospector_SRCS} ${intron_prospector_merge_SRCS}

shared_OBJS = ${shared_SRCS:%.cc=${OBJDIR}/%.o}
intron_prospector_OBJS = ${intron_prospector_SRCS:%.cc=${OBJDIR}/%.o}
intron_prospector_merge_OBJS = ${intron_prospector_merge_SRCS:%.cc=${OBJDIR}/%.o}

DEPENDS = ${SRCS:%.cc=%.depend}

CXX = @CXX@
CXXFLAGS = @CXXFLAGS@ -std=c++14
CPPFLAGS = @CPPFLAGS@
LDFLAGS = @LDFLAGS@
LIBS = @LIBS@

.PHONY: all
all: ${intron_prospector} ${intron_prospector_merge}

${intron_prospector}: ${shared_OBJS} ${intron_prospector_OBJS}
	@mkdir -p $(dir $@)
	${CXX} ${CXXFLAGS} ${LDFLAGS} -o $@ $^ ${LIBS}

${intron_prospector_merge}: ${shared_OBJS} ${intron_prospector_merge_OBJS}
	@mkdir -p $(dir $@)
	${CXX} ${CXXFLAGS} ${LDFLAGS} -o $@ $^ ${LIBS}

# dependency file is generate as part of compile
${OBJDIR}/%.o: %.cc Makefile
	@mkdir -p $(dir $@)
	${CXX} ${CPPFLAGS} ${CXXFLAGS} -c -MM -MT $@ $< >$*.depend
	${CXX} ${CPPFLAGS} ${CXXFLAGS} -c -o $@ $<

.PHONY: clean
clean:
	rm -f ${OBJS} ${intron_prospector} ${DEPENDS}

.PHONY: distclean
distclean: clean
	rm -f Makefile

# Generate *.man.h files, which is included to define help message.  This
# requires pandoc, so it results checked in and only generated by developers.
# A two level make is used so that the rules will not be run unless specifically
# requested.
.PHONY: doc dodoc
doc:
	${MAKE} dodoc dodoc=yes

ifeq (${dodoc},yes)
dodoc:  intron-prospector.man.h intron-prospector-merge.man.h

%.man.h: ../docs/%.md mkManHelp.awk
	pandoc -f markdown -t plain  $< >$@.txt.tmp
	awk -f mkManHelp.awk $@.txt.tmp > $@.tmp
	mv $@.tmp $@
	rm -f $@.txt.tmp
endif	


# don't fail on missing dependencies, they are first time the .o is generates
-include ${DEPENDS}

# Local Variables:
# mode: makefile-gmake
# End:
