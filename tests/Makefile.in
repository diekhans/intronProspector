# -*- mode: makefile -*-
ROOT = ..
BINDIR = ${ROOT}/bin

intron_prospector = ${BINDIR}/intron-prospector
intron_prospector_merge = ${BINDIR}/intron-prospector-merge

# Test run command in various ways and compares to expected output

diff = diff -u

basic_sam = input/test_basic.sam
basic_bam = output/test_basic.bam
multi_sam = input/test_multi.sam
multi_one_sam = input/test_multi.one.sam
multi_two_sam = input/test_multi.two.sam
fake10_star_sam = input/fake10.star.sam
fake10_hisat2_sam = input/fake10.hisat2.sam
fake10_missing_sam = input/fake10.missing.sam
fake10_fa = output/fake10_genome.fa
fake10_fai = output/fake10_genome.fa.fai
fake10_scramble_fa = output/fake10_scramble_genome.fa
fake10_scramble_fai = output/fake10_scramble_genome.fa.fai
ont_sam = input/ont.sam

# most tests were developed before confidence scores default was changed
conf0 = --min-confidence-score=0.0

define diff_out
	${diff} expected/$@.introns.tsv output/$@.introns.tsv
	${diff} expected/$@.juncs.bed output/$@.juncs.bed
	${diff} expected/$@.introns.bed output/$@.introns.bed
endef
define diff_tsv
	${diff} expected/$@.introns.tsv output/$@.introns.tsv
endef

# $(call diff_out,nongztest)
define diff_out_gz
	gunzip -c output/$@.introns.tsv.gz > output/$@.introns.tsv
	${diff} expected/$1.introns.tsv output/$@.introns.tsv
	gunzip -c output/$@.juncs.bed.gz > output/$@.juncs.bed
	${diff} expected/$1.juncs.bed output/$@.juncs.bed
	gunzip -c output/$@.introns.bed.gz > output/$@.introns.bed
	${diff} expected/$1.introns.bed output/$@.introns.bed
endef

.PHONY: all
all:

.PHONY: test
test: intron_prospectorTests intron_prospector_mergeTests

#####
# intron_prospector tests
#####
intron_prospectorTests: basicTests minReadCountTests multiTests fake10Tests regressTests ontTests multiBamTests \
	sjfilterTests strandTagTests parityTests errorTests

###
# basic tests
##
basicTests: testBasic1 testBasic1gz testBasic2 testBasic3 testBasic4 testBasic5

# basic unstranded
testBasic1: mkout
	${intron_prospector} ${conf0} --junction-bed=output/$@.juncs.bed --intron-bed=output/$@.introns.bed --intron-bed6=output/$@.introns.bed6 --intron-calls=output/$@.introns.tsv --pass-through=output/$@.sam ${basic_sam}
	${diff_out}
	${diff} expected/$@.introns.bed6 output/$@.introns.bed6
	${diff} ${basic_sam} output/$@.sam

testBasic1gz: mkout
	${intron_prospector} ${conf0} --junction-bed=output/$@.juncs.bed.gz --intron-bed=output/$@.introns.bed.gz --intron-bed6=output/$@.introns.bed6.gz --intron-calls=output/$@.introns.tsv.gz ${basic_sam}
	$(call diff_out_gz,testBasic1)
	gunzip -c output/$@.introns.bed6.gz > output/$@.gz.introns.bed6
	${diff} expected/testBasic1.introns.bed6 output/$@.gz.introns.bed6

# RF strandness
testBasic2: mkout
	${intron_prospector} --strandness=RF ${conf0} --junction-bed=output/$@.juncs.bed --intron-bed=output/$@.introns.bed --intron-calls=output/$@.introns.tsv ${basic_sam}
	${diff_out}

# testBasic1 with BAM
testBasic3: mkout ${basic_bam}
	${intron_prospector} ${conf0} --junction-bed=output/$@.juncs.bed --intron-bed=output/$@.introns.bed --pass-through=output/$@.bam --intron-calls=output/$@.introns.tsv ${basic_bam}
	${diff_out}
	samtools view -h --no-PG output/$@.bam >output/$@.sam
	${diff} ${basic_sam} output/$@.sam

# test confidence score filter
testBasic4: mkout ${basic_bam}
	${intron_prospector} --min-confidence-score=1.0 --junction-bed=output/$@.juncs.bed --intron-bed=output/$@.introns.bed --intron-calls=output/$@.introns.tsv ${basic_bam}
	${diff_out}

# test exclude multi filter
testBasic5: mkout ${basic_bam}
	${intron_prospector} --exclude=multi ${conf0} --junction-bed=output/$@.juncs.bed --intron-bed=output/$@.introns.bed --intron-calls=output/$@.introns.tsv ${basic_bam}
	${diff_out}

##
# Minimum junction supporting read count tests.
##
minReadCountTests: testMinReadDefault testMinReadGTE testMinReadBelowThreshold testMinReadFilterAllJuncs

# test that passing an explicit threshold of 0 matches the default behavior of 0
testMinReadDefault: mkout ${basic_bam}
	${intron_prospector} ${conf0} --junction-bed=output/$@.juncs.bed --intron-bed=output/$@.introns.bed --intron-calls=output/$@.introns.tsv ${basic_bam}
	${diff_out}
	${intron_prospector} ${conf0} --min-read-count=0 --junction-bed=output/$@.juncs.bed --intron-bed=output/$@.introns.bed --intron-calls=output/$@.introns.tsv ${basic_bam}	
	${diff_out}

# test that read count filter removes reads below the threshold.
testMinReadBelowThreshold: mkout ${basic_bam}
	${intron_prospector} ${conf0} --min-read-count=30 --junction-bed=output/$@.juncs.bed --intron-bed=output/$@.introns.bed --intron-calls=output/$@.introns.tsv ${basic_bam}
	${diff_out}

# test read count filter against multi junction bam file and filter out junctions that are less than the threshold and keep anything greater than or equal to the threshold. 
# Threshold matches the read count of a junction exactly. The junciton with read count 45 should be in the output.
testMinReadGTE: mkout ${basic_bam}
	${intron_prospector} ${conf0} --min-read-count=45 --junction-bed=output/$@.juncs.bed --intron-bed=output/$@.introns.bed --intron-calls=output/$@.introns.tsv ${basic_bam}
	${diff_out}

# test that high min read count threshold still outputs files even if they are empty
testMinReadFilterAllJuncs: mkout ${basic_bam}
	${intron_prospector} ${conf0} --min-read-count=100000 --junction-bed=output/$@.juncs.bed --intron-bed=output/$@.introns.bed --intron-calls=output/$@.introns.tsv ${basic_bam}
	${diff_out}

# test that when inputting multiple files, junctions are filtered after they are aggregated. Consider junction on CM000676.2 at 52661304. Both multi_one_sam and multi_two_sam have read count 2 when
# generated individually (see *.introns.bed). When generated as multi sam that junction has score 4. Use min read count of 3. If filtering happens before aggregation, that junction won't appear. Since filtering
# is intended to happen after aggregation, the junction should still be reported.
testMinReadMultiSam: mkout ${multi_one_sam} ${multi_two_sam}
	${intron_prospector} ${conf0} --min-read-count=3 --junction-bed=output/$@.juncs.bed --intron-bed=output/$@.introns.bed --intron-calls=output/$@.introns.tsv ${multi_one_sam} ${multi_two_sam}
	${diff_out}

# Not Tests. Use the following to generate multi_one_sam and multi_two_sam to visualize the case for junction CM000676.2 at 52661304 for testMinReadMultiSam
tempGenerateSamOne: ${multi_one_sam}
	${intron_prospector} ${conf0} --junction-bed=output/$@.juncs.bed --intron-bed=output/$@.introns.bed --intron-calls=output/$@.introns.tsv ${multi_one_sam}

tempGenerateSamTwo: ${multi_two_sam}
	${intron_prospector} ${conf0} --junction-bed=output/$@.juncs.bed --intron-bed=output/$@.introns.bed --intron-calls=output/$@.introns.tsv ${multi_two_sam}

###
# multi-introns per read tests
##
multiTests: testMulti1

testMulti1: mkout
	${intron_prospector} ${conf0} --junction-bed=output/$@.juncs.bed --intron-bed=output/$@.introns.bed --intron-calls=output/$@.introns.tsv ${multi_sam}
	${diff_out}
	bedToBigBed output/$@.juncs.bed input/test_multi.size output/$@.juncs.bigBed
	bedToBigBed output/$@.introns.bed input/test_multi.size output/$@.introns.bigBed

##
# fake10 tests
##
fake10Tests: testFake10a testFake10agz testFake10aConf testFake10b testFake10c

# fake10 STAR mappings (SAM doesn't have strand)
testFake10a: mkout ${fake10_fa} ${fake10_fai}
	${intron_prospector} ${conf0} --genome-fasta=${fake10_fa} --junction-bed=output/$@.juncs.bed --intron-bed=output/$@.introns.bed --intron-calls=output/$@.introns.tsv --pass-through=output/$@.sam --debug-trace=output/$@.debug.tsv ${fake10_star_sam}
	${diff_out}
	${diff} expected/$@.debug.tsv output/$@.debug.tsv
	${diff} ${fake10_star_sam} output/$@.sam

testFake10agz: mkout ${fake10_fa} ${fake10_fai}
	${intron_prospector} ${conf0} --genome-fasta=${fake10_fa} --junction-bed=output/$@.juncs.bed.gz --intron-bed=output/$@.introns.bed.gz --intron-calls=output/$@.introns.tsv.gz --debug-trace=output/$@.debug.tsv.gz ${fake10_star_sam}
	$(call diff_out_gz,testFake10a)
	gunzip -c output/$@.debug.tsv.gz > output/$@.debug.tsv
	${diff} expected/testFake10a.debug.tsv output/$@.debug.tsv

# condidence default
testFake10aConf: mkout ${fake10_fa} ${fake10_fai}
	${intron_prospector} --genome-fasta=${fake10_fa} --junction-bed=output/$@.juncs.bed --intron-bed=output/$@.introns.bed --intron-calls=output/$@.introns.tsv --pass-through=output/$@.sam --debug-trace=output/$@.debug.tsv ${fake10_star_sam}
	${diff_out}
	${diff} expected/$@.debug.tsv output/$@.debug.tsv
	${diff} ${fake10_star_sam} output/$@.sam


# fake10 hisat2 mappings
testFake10b: mkout ${fake10_fa} ${fake10_fai}
	${intron_prospector} ${conf0} --genome-fasta=${fake10_fa}  --junction-bed=output/$@.juncs.bed --intron-bed=output/$@.introns.bed --intron-calls=output/$@.introns.tsv --pass-through=output/$@.sam ${fake10_hisat2_sam}
	${diff_out}
	${diff} ${fake10_hisat2_sam} output/$@.sam

# fake10 hisat2 mappings with missing target sequence
testFake10c: mkout ${fake10_fa} ${fake10_fai}
	${intron_prospector} ${conf0} --genome-fasta=${fake10_fa} --skip-missing-targets --junction-bed=output/$@.juncs.bed --intron-bed=output/$@.introns.bed --intron-calls=output/$@.introns.tsv ${fake10_missing_sam} > output/$@.err 2>&1
	${diff} expected/$@.err output/$@.err
	${diff_out}

sjfilterTests: testSjFilterDefault testSjFilterCanon testSjFilterAll

testSjFilterDefault: mkout ${fake10_scramble_fa} ${fake10_scramble_fai}
	${intron_prospector} ${conf0} --genome-fasta=${fake10_scramble_fa} --junction-bed=output/$@.juncs.bed --intron-bed=output/$@.introns.bed --intron-calls=output/$@.introns.tsv ${fake10_star_sam}
	${diff_out}

testSjFilterCanon: mkout ${fake10_scramble_fa} ${fake10_scramble_fai}
	${intron_prospector} ${conf0} --sj-filter=canon --genome-fasta=${fake10_scramble_fa} --junction-bed=output/$@.juncs.bed --intron-bed=output/$@.introns.bed --intron-calls=output/$@.introns.tsv ${fake10_star_sam}
	${diff_out}

testSjFilterAll: mkout ${fake10_scramble_fa} ${fake10_scramble_fai}
	${intron_prospector} ${conf0} --sj-filter=all --genome-fasta=${fake10_scramble_fa} --junction-bed=output/$@.juncs.bed --intron-bed=output/$@.introns.bed --intron-calls=output/$@.introns.tsv ${fake10_star_sam}
	${diff_out}


regressTests: testSortBug

# bug where bed was incorrectly sorted
testSortBug: mkout
	${intron_prospector} --junction-bed=output/$@.juncs.bed --intron-bed=output/$@.introns.bed input/sort-bug.sam
	bedToBigBed -type=bed12 -tab output/$@.juncs.bed input/sort-bug.size output/$@.juncs.bigBed
	bedToBigBed -type=bed9 -tab output/$@.introns.bed input/sort-bug.size output/$@.introns.bigBed

#####
# intron_prospector_merge tests
#####
intron_prospector_mergeTests: testBasic134Merge testBasic134MergeGz testBasic134LstMerge testFake10abMerge \
	testStrandConflictMerge testSjFilterCanonMerge testSjFilterAllMerge testSjFilterDefaultMerge \
	minReadCountMergeTests mergeErrorTests

testBasic134Merge: mkout
	${intron_prospector_merge} --junction-bed=output/$@.juncs.bed --intron-bed=output/$@.introns.bed --intron-calls=output/$@.introns.tsv \
	    expected/testBasic1.introns.tsv expected/testBasic3.introns.tsv expected/testBasic4.introns.tsv
	${diff_out}

testBasic134MergeGz: mkout
	gzip -c expected/testBasic1.introns.tsv > output/testBasic1_gz.introns.tsv.gz
	gzip -c expected/testBasic3.introns.tsv > output/testBasic3_gz.introns.tsv.gz
	gzip -c expected/testBasic4.introns.tsv > output/testBasic4_gz.introns.tsv.gz
	${intron_prospector_merge} --junction-bed=output/$@.juncs.bed.gz --intron-bed=output/$@.introns.bed.gz --intron-calls=output/$@.introns.tsv.gz \
	    output/testBasic1_gz.introns.tsv.gz output/testBasic3_gz.introns.tsv.gz output/testBasic4_gz.introns.tsv.gz
	$(call diff_out_gz,testBasic134Merge)

# same merge as testBasic134Merge but via --intron-calls-files list, exercising
# the read_input_call_list path.  Uses existing testBasic134LstMerge expected files.
testBasic134LstMerge: mkout
	${intron_prospector_merge} --intron-calls-files=input/basic134.files.txt \
	    --junction-bed=output/$@.juncs.bed --intron-bed=output/$@.introns.bed --intron-calls=output/$@.introns.tsv
	${diff_out}

testFake10abMerge: mkout
	${intron_prospector_merge} --intron-calls=output/$@.introns.tsv \
	    expected/testFake10a.introns.tsv expected/testFake10b.introns.tsv
	${diff} expected/$@.introns.tsv output/$@.introns.tsv

testStrandConflictMerge: mkout
	${intron_prospector_merge} --intron-calls=output/$@.introns.tsv \
	   input/strand-confict/SRR6225360.calls.tsv input/strand-confict/SRR6225362.calls.tsv \
	   input/strand-confict/SRR6225361.calls.tsv input/strand-confict/SRR6225363.calls.tsv 2> output/$@.err
	${diff_tsv}

testSjFilterCanonMerge: mkout
	${intron_prospector_merge} --sj-filter=canon --junction-bed=output/$@.juncs.bed --intron-bed=output/$@.introns.bed --intron-calls=output/$@.introns.tsv \
	   expected/testSjFilterAll.introns.tsv	    
	${diff_out}

testSjFilterAllMerge: mkout
	${intron_prospector_merge} --sj-filter=all --junction-bed=output/$@.juncs.bed --intron-bed=output/$@.introns.bed --intron-calls=output/$@.introns.tsv \
	   expected/testSjFilterAll.introns.tsv	    
	${diff_out}

testSjFilterDefaultMerge: mkout
	${intron_prospector_merge} --junction-bed=output/$@.juncs.bed --intron-bed=output/$@.introns.bed --intron-calls=output/$@.introns.tsv \
	   expected/testSjFilterAll.introns.tsv	    
	${diff_out}

##
# Minimum junction supporting read count tests for intron_prospector_merge.
##
minReadCountMergeTests: testMergeMinReadDefault testMergeMinReadBelowThreshold testMergeMinReadGTE \
	testMergeMinReadFilterAllJuncs testMergeFilterPostAggregation

# test that passing an explicit threshold of 0 matches default behavior. Merges basic 1, 3, and 4.
testMergeMinReadDefault: mkout
	${intron_prospector_merge} --junction-bed=output/$@.juncs.bed --intron-bed=output/$@.introns.bed --intron-calls=output/$@.introns.tsv \
	    expected/testBasic1.introns.tsv expected/testBasic3.introns.tsv expected/testBasic4.introns.tsv
	${diff_out}
	${intron_prospector_merge} --min-read-count=0 --junction-bed=output/$@.juncs.bed --intron-bed=output/$@.introns.bed --intron-calls=output/$@.introns.tsv \
	    expected/testBasic1.introns.tsv expected/testBasic3.introns.tsv expected/testBasic4.introns.tsv
	${diff_out}

# test that read count filter removes merged junctions below threshold.
testMergeMinReadBelowThreshold: mkout
	${intron_prospector_merge} --min-read-count=30 --junction-bed=output/$@.juncs.bed --intron-bed=output/$@.introns.bed --intron-calls=output/$@.introns.tsv \
	    expected/testBasic1.introns.tsv expected/testBasic3.introns.tsv expected/testBasic4.introns.tsv
	${diff_out}

# test read count filter where threshold equals an expected merged junction count. Tests that the functionality is >= and not just >.
testMergeMinReadGTE: mkout
	${intron_prospector_merge} --min-read-count=135 --junction-bed=output/$@.juncs.bed --intron-bed=output/$@.introns.bed --intron-calls=output/$@.introns.tsv \
	    expected/testBasic1.introns.tsv expected/testBasic3.introns.tsv expected/testBasic4.introns.tsv
	${diff_out}

# test that high threshold still outputs valid (possibly empty) files.
testMergeMinReadFilterAllJuncs: mkout
	${intron_prospector_merge} --min-read-count=100000 --junction-bed=output/$@.juncs.bed --intron-bed=output/$@.introns.bed --intron-calls=output/$@.introns.tsv \
	    expected/testBasic1.introns.tsv expected/testBasic3.introns.tsv expected/testBasic4.introns.tsv
	${diff_out}

# Test that the read counts are filtered after the junctions are merged. The chr10	5000666 junction for example has 1 read count in testBasic1.introns.tsv and in testBasic3.introns.tsv
# To make sure we filter after aggregation, filter on min-read-count=2 so that if the filtering was done before the aggregation, chr10	5000666 would not appear in the output.
testMergeFilterPostAggregation: mkout
	${intron_prospector_merge} --min-read-count=2 --junction-bed=output/$@.juncs.bed --intron-bed=output/$@.introns.bed --intron-calls=output/$@.introns.tsv \
	    expected/testBasic1.introns.tsv expected/testBasic3.introns.tsv expected/testBasic4.introns.tsv
	${diff_out}


##
# ONT tests
##
ontTests: testOnt1 testOntIndel testOntSkipTargets testOntOutOfOrderTargets testOntUnsorted

testOnt1: mkout
	${intron_prospector} ${conf0} --junction-bed=output/$@.juncs.bed --intron-bed=output/$@.introns.bed --intron-calls=output/$@.introns.tsv --pass-through=output/$@.sam ${ont_sam}
	${diff_out}
	${diff} ${ont_sam} output/$@.sam

testOntIndel: mkout
	${intron_prospector} ${conf0} --allow-anchor-indels --junction-bed=output/$@.juncs.bed --intron-bed=output/$@.introns.bed --intron-calls=output/$@.introns.tsv ${ont_sam}
	${diff_out}

testOntSkipTargets: mkout
	${intron_prospector} ${conf0} --allow-anchor-indels --junction-bed=output/$@.juncs.bed --intron-bed=output/$@.introns.bed --intron-calls=output/$@.introns.tsv input/ont-skip-targets.sam
	${diff_out}

testOntOutOfOrderTargets: mkout
	${intron_prospector} --allow-anchor-indels input/ont-out-of-order-targets.sam > output/$@.err 2>&1 || true
	${diff} expected/$@.err output/$@.err

##
# test of multiple BAMs at once
#
# test_multi.sam is split into two parts
##
multiBamTests: testMultiSam

testMultiSam: mkout
	${intron_prospector} ${conf0} --junction-bed=output/$@.juncs.bed --intron-bed=output/$@.introns.bed --intron-calls=output/$@.introns.tsv ${multi_one_sam} ${multi_two_sam}
	${diff_out}

testOntUnsorted: mkout
	${intron_prospector} --unsorted --allow-anchor-indels --junction-bed=output/$@.juncs.bed --intron-bed=output/$@.introns.bed --intron-calls=output/$@.introns.tsv input/ont-out-of-order-targets.sam
	${diff_out}


##
# Strand tag pass-through tests.  Exercise --set-XS-strand-tag and
# --set-TS-strand-tag which write XS/TS tags into the pass-through BAM/SAM.
##
strandTagTests: testStrandTagAdd testStrandTagUpdate

# STAR input has no XS tag; code should add XS and TS.
testStrandTagAdd: mkout ${fake10_fa} ${fake10_fai}
	${intron_prospector} ${conf0} --genome-fasta=${fake10_fa} --set-XS-strand-tag --set-TS-strand-tag \
	    --pass-through=output/$@.sam ${fake10_star_sam}
	${diff} expected/$@.sam output/$@.sam

# hisat2 input already has XS tag; code should overwrite it via bam_aux_del + bam_aux_append.
# Expected file was built with --set-XS-strand-tag only (no TS).
testStrandTagUpdate: mkout ${fake10_fa} ${fake10_fai}
	${intron_prospector} ${conf0} --genome-fasta=${fake10_fa} --set-XS-strand-tag \
	    --pass-through=output/$@.sam ${fake10_hisat2_sam}
	${diff} expected/$@.sam output/$@.sam

##
# Parity check: --unsorted code path should produce same output as the
# per-target code path for a properly sorted BAM.  Guards against divergence
# between extract_junctions_by_target and extract_junctions_unsorted.
##
parityTests: testUnsortedSortedParity

testUnsortedSortedParity: mkout
	${intron_prospector} ${conf0} --junction-bed=output/$@.sorted.juncs.bed --intron-bed=output/$@.sorted.introns.bed --intron-calls=output/$@.sorted.introns.tsv ${basic_sam}
	${intron_prospector} ${conf0} --unsorted --junction-bed=output/$@.unsorted.juncs.bed --intron-bed=output/$@.unsorted.introns.bed --intron-calls=output/$@.unsorted.introns.tsv ${basic_sam}
	${diff} output/$@.sorted.introns.tsv output/$@.unsorted.introns.tsv
	${diff} output/$@.sorted.juncs.bed output/$@.unsorted.juncs.bed
	${diff} output/$@.sorted.introns.bed output/$@.unsorted.introns.bed

##
# Command-line error-path tests.  Each runs a bad invocation, captures
# stderr, and diffs against a stored expected file.  To bootstrap the
# expected output for a new rule:
#   make -k <rule>            # will fail on missing expected
#   cp output/<rule>.err expected/
##
errorTests: testStrandnessInvalid testExcludeInvalid testSjFilterInvalid \
	testSjFilterCanonNoGenome testPassThroughMultiBam testStrandTagNoPassThrough

# invalid --strandness value
testStrandnessInvalid: mkout
	${intron_prospector} --strandness=XX ${basic_sam} > output/$@.err 2>&1 || true
	${diff} expected/$@.err output/$@.err

# invalid --excludes category
testExcludeInvalid: mkout
	${intron_prospector} --excludes=bogus ${basic_sam} > output/$@.err 2>&1 || true
	${diff} expected/$@.err output/$@.err

# invalid --sj-filter value
testSjFilterInvalid: mkout
	${intron_prospector} --sj-filter=weird ${basic_sam} > output/$@.err 2>&1 || true
	${diff} expected/$@.err output/$@.err

# --sj-filter=canon requires --genome-fasta
testSjFilterCanonNoGenome: mkout
	${intron_prospector} --sj-filter=canon ${basic_sam} > output/$@.err 2>&1 || true
	${diff} expected/$@.err output/$@.err

# --pass-through rejected with multiple input BAMs
testPassThroughMultiBam: mkout
	${intron_prospector} ${conf0} --pass-through=output/$@.sam ${multi_one_sam} ${multi_two_sam} > output/$@.err 2>&1 || true
	${diff} expected/$@.err output/$@.err

# --set-XS-strand-tag requires --pass-through and --genome-fasta
testStrandTagNoPassThrough: mkout
	${intron_prospector} --set-XS-strand-tag ${basic_sam} > output/$@.err 2>&1 || true
	${diff} expected/$@.err output/$@.err

##
# intron-prospector-merge error-path tests.
##
mergeErrorTests: testMergeNoInputs

# no positional args and no --intron-calls-files
testMergeNoInputs: mkout
	${intron_prospector_merge} --intron-calls=output/$@.introns.tsv > output/$@.err 2>&1 || true
	${diff} expected/$@.err output/$@.err


###
# other rules
##
.PHONY: mkout
mkout:
	@mkdir -p output

output/%.bam: input/%.sam
	@mkdir -p output
	samtools view -b --no-PG $< >$@.tmp
	mv -f $@.tmp $@

output/%.fa: input/%.fa
	@mkdir -p output
	cp $< output/$*.fa

output/%.fa.fai: output/%.fa
	samtools faidx $<

.PHONY: clean
clean:
	rm -rf output

.PHONY: distclean
distclean: clean
	rm -f Makefile
